# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Neon Postgres -----------------------------------------------------
# Neon project dashboard > Connection Details. Use the pooled connection
# string for DATABASE_URL (the app talks to it over HTTP via
# @neondatabase/serverless, so pooling matters more than for a long-lived
# TCP connection).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Name of the Neon branch the app should read/write (usually "production").
NEON_BRANCH=

# --- Neon Auth -----------------------------------------------------------
# Neon project dashboard > Auth tab, after enabling Neon Auth on the project.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Any random string, 32+ characters. Used to sign session cookies.
NEON_AUTH_COOKIE_SECRET=

# --- Access control --------------------------------------------------------
# The only email allowed to sign up / sign in. Every server action and the
# (app) layout check the session's email against this — anyone else gets a
# 403, even if they manage to create an account.
ALLOWED_EMAIL=

# --- TMDB (movies/TV) ------------------------------------------------------
# themoviedb.org > Settings > API > API Read Access Token (v4 auth, a long
# bearer token, not the shorter v3 "API Key").
TMDB_READ_TOKEN=

# --- IGDB / Twitch (games) --------------------------------------------------
# dev.twitch.tv/console > Applications > Register Your Application.
# IGDB authenticates through Twitch's client-credentials OAuth flow.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
